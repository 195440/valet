# Nothing in this repository needs a dependency's install script, so none of them run:
# - near-sandbox would download a nearcore 2.6.2 binary that the tests do not use
#   (the harness fetches 2.14.0 itself and checks its SHA-256),
# - secp256k1 would compile a native addon for key types Valet never uses.
# `npm run <script>` and `npm test` still work; only lifecycle scripts are skipped.
ignore-scripts=true
